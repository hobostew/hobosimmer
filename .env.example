# Copy to .env.local for local dev; set the same names in Vercel for production.

# Google AI Studio key. Needed to find new recipes (it searches the web) and to read a page that won't open for us.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# What each phone enters once. Required: without it nothing answers.
HOUSEHOLD_PASSCODE=

# The household's time zone (an IANA name: America/New_York, Europe/London). Everything in the app is in this zone.
HOUSEHOLD_TZ=America/Los_Angeles

# Where the data lives in production: Upstash Redis. Vercel sets these when a Redis store is linked to the project.
# Leave them blank for local dev and the app reads data/*.csv instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Settings → Copy to Google Sheet, which writes everything out to a Sheet as a backup. Without these, that
# one button is all that doesn't work. The Sheet's id is in src/lib/google/sheets.ts; set SHEET_ID for a different one.
SHEET_ID=
# The service account key file's entire JSON, on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
